<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الحقيبة التفاعلية للتحصيلي</title>
    
    <!-- SEO & Fonts -->
    <meta name="description" content="الحقيبة التفاعلية للتحصيلي - تجربة تدريبية احترافية">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap');
        
        :root {
            --primary: #0e7490;        /* تركواز احترافي غامق */
            --primary-light: #22d3ee;  /* تركواز مضيء للتفاعل */
            --bg-dark: #0f172a;       /* رمادي فحمي مائل للأزرق */
            --bg-card: #1e293b;       /* رمادي البطاقات */
            --text-main: #f1f5f9;     /* رمادي فاتح جداً للنصوص */
            --text-muted: #94a3b8;    /* رمادي مطفي */
        }

        body { 
            font-family: 'Tajawal', sans-serif; 
            background-color: var(--bg-dark);
            color: var(--text-main);
            margin: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* تأثيرات الخلفية */
        .glow-bg {
            position: absolute;
            top: 20%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(14, 116, 144, 0.15) 0%, rgba(15, 23, 42, 0) 70%);
            z-index: -1;
            filter: blur(60px);
        }

        .main-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
            text-align: center;
            z-index: 10;
        }

        /* شعار الحقيبة */
        .logo-box {
            position: relative;
            background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-dark) 100%);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .logo-box i {
            background: linear-gradient(to bottom right, var(--primary-light), var(--primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* العنوان الاحترافي */
        .title-premium {
            background: linear-gradient(to bottom, #ffffff 0%, #cbd5e1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }

        /* زر ابدأ التدريب */
        .btn-premium {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            box-shadow: 0 0 20px rgba(14, 116, 144, 0.3), inset 0 1px 1px rgba(255,255,255,0.2);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
        }

        .btn-premium:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(34, 211, 238, 0.4);
            filter: brightness(1.1);
        }

        .btn-premium::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 50%);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .btn-premium:hover::after {
            opacity: 1;
        }

        /* قسم التواصل الاجتماعي */
        .social-glass {
            background: rgba(30, 41, 59, 0.5);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .social-link {
            color: var(--text-muted);
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.05);
            transition: all 0.3s ease;
        }

        .social-link:hover {
            color: var(--primary-light);
            background: rgba(14, 116, 144, 0.1);
            border-color: var(--primary-light);
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(34, 211, 238, 0.2);
        }

        footer {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            background: rgba(15, 23, 42, 0.8);
        }
    </style>
</head>
<body>

    <!-- Glow Effect -->
    <div class="glow-bg"></div>

    <main class="main-container">
        <!-- Modern Logo -->
        <div class="logo-box w-28 h-28 rounded-[2.5rem] flex items-center justify-center mb-10 group">
            <i class="fas fa-graduation-cap text-6xl group-hover:scale-110 transition-transform duration-500"></i>
        </div>

        <!-- Premium Title -->
        <h1 class="text-5xl md:text-8xl font-black mb-6 tracking-tighter title-premium">
            الحقيبة التفاعلية
        </h1>
        <h2 class="text-3xl md:text-4xl font-bold text-cyan-500/80 mb-8 tracking-wide">
            للتحصيلي العلمي
        </h2>
        
        <p class="text-gray-400 text-lg md:text-xl mb-16 max-w-xl font-light leading-relaxed">
            الجيل القادم من التدريب الذكي. محتوى تعليمي متطور يختصر لك الوقت ويضمن لك أعلى الدرجات.
        </p>

        <!-- Main CTA -->
        <button class="btn-premium px-24 py-7 rounded-[2rem] font-black text-3xl mb-24 tracking-tight group">
            ابدأ التدريب
            <i class="fas fa-arrow-left mr-3 text-2xl group-hover:-translate-x-2 transition-transform"></i>
        </button>

        <!-- Social Grid -->
        <div class="social-glass p-10 rounded-[3rem] w-full max-w-lg">
            <div class="flex items-center justify-center gap-5 mb-8">
                <div class="h-[1px] bg-white/5 flex-1"></div>
                <span class="text-text-muted text-xs font-bold uppercase tracking-[0.3em]">قنوات التواصل</span>
                <div class="h-[1px] bg-white/5 flex-1"></div>
            </div>
            
            <div class="flex justify-between items-center px-4">
                <a href="#" class="social-link w-16 h-16 rounded-2xl flex items-center justify-center text-2xl">
                    <i class="fab fa-x-twitter"></i>
                </a>
                <a href="#" class="social-link w-16 h-16 rounded-2xl flex items-center justify-center text-2xl">
                    <i class="fab fa-telegram-plane"></i>
                </a>
                <a href="#" class="social-link w-16 h-16 rounded-2xl flex items-center justify-center text-2xl">
                    <i class="fab fa-whatsapp"></i>
                </a>
                <a href="#" class="social-link w-16 h-16 rounded-2xl flex items-center justify-center text-2xl">
                    <i class="fab fa-instagram"></i>
                </a>
            </div>
        </div>
    </main>

    <!-- Professional Footer -->
    <footer class="py-12 text-center text-text-muted text-sm font-medium tracking-wide">
        <p>جميع الحقوق محفوظة لصالح الحقيبة التفاعلية للتحصيلي &copy; 2024</p>
    </footer>

    <script>
        // زر ابدأ التدريب مع تأثير اهتزاز خفيف
        const startBtn = document.querySelector('.btn-premium');
        startBtn.addEventListener('mouseenter', () => {
            console.log('Premium UI Ready');
        });
    </script>
</body>
</html>
